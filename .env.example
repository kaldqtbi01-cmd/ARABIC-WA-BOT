# الجهاز
BOT_NAME=ARABIC-WA-BOT
PREFIX=.

# رمز الربط: رقم WhatsApp بصيغة دولية وأرقام فقط، أو اتركه فارغًا لعرض QR
PAIRING_NUMBER=

# أرقام المالك مفصولة بفواصل، بصيغة دولية دون + أو مسافات
OWNER_NUMBERS=

# لا تشارك الجلسة أو هذا الملف. تُحفظ الجلسة محليًا.
SESSION_DIR=./sessions/auth
DATA_FILE=./database/data.json

# إعداد اختياري لمزود متوافق مع OpenAI Chat Completions
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
HTTP_TIMEOUT_MS=15000

LOG_LEVEL=silent
RECONNECT_DELAY_MS=5000
